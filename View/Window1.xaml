<Window x:Class="ShoppingCart.View.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoppingCart.View"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Enter Student Name" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Enter Customer Phone" />
            <Button Content="Add Customer" Command="{Binding AddCustomerCommand}"/>
            <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" />
            <ListBox ItemsSource="{Binding CustomerNames}">
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
